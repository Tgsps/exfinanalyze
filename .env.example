# ── Supabase (required) ──────────────────────────────────────────────
# Found at: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Gemini AI (server-side only — DO NOT prefix with VITE_) ──────────
# The API key must be set as a Supabase Edge Function secret, NOT here.
# Run: supabase secrets set GEMINI_API_KEY=your-gemini-key
# Get key at: https://aistudio.google.com/app/apikey
#
# ⚠️  NEVER set VITE_GEMINI_API_KEY — any VITE_ variable is bundled
#     into the client JS and visible to all users in DevTools.

# ── Optional: restrict Edge Function CORS to your domain ────────────
# ALLOWED_ORIGIN=https://yourdomain.com
